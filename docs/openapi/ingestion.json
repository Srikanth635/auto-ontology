{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NeemFileState": {
        "additionalProperties": true,
        "description": "What the NEEM folder watcher knows about one file.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rows": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rows"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "updated_at": {
            "default": 0.0,
            "title": "Updated At",
            "type": "number"
          }
        },
        "required": [
          "name",
          "state"
        ],
        "title": "NeemFileState",
        "type": "object"
      },
      "NeemWatchStatusResponse": {
        "additionalProperties": true,
        "description": "The ingestion service's NEEM folder watcher (``GET /neem/status``).",
        "properties": {
          "catalog": {
            "default": "idle",
            "title": "Catalog",
            "type": "string"
          },
          "database": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database"
          },
          "directory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Directory"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "files": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/NeemFileState"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "enabled"
        ],
        "title": "NeemWatchStatusResponse",
        "type": "object"
      },
      "ReembedStatusResponse": {
        "additionalProperties": true,
        "description": "Whether a re-embed pass is running, and how the last one ended.\n\nA pass rebuilds every vector after the embedding model changes. Timestamps\nare ISO 8601; ``last_error`` is set only when the last pass failed.",
        "properties": {
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Finished At"
          },
          "last_started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Started At"
          },
          "running": {
            "title": "Running",
            "type": "boolean"
          }
        },
        "required": [
          "running",
          "last_started_at",
          "last_finished_at",
          "last_error"
        ],
        "title": "ReembedStatusResponse",
        "type": "object"
      },
      "SemanticRunningResponse": {
        "additionalProperties": true,
        "description": "The ingestion service's own status endpoint: whether a compilation pass\nis executing right now, when the last one finished successfully, and when\nit last failed (only set if more recent than the last success).",
        "properties": {
          "last_failure_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Failure At"
          },
          "last_success_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success At"
          },
          "running": {
            "title": "Running",
            "type": "boolean"
          }
        },
        "required": [
          "running",
          "last_success_at",
          "last_failure_at"
        ],
        "title": "SemanticRunningResponse",
        "type": "object"
      },
      "StatusResponse": {
        "additionalProperties": true,
        "description": "``{\"status\": \"ok\"}`` or ``{\"status\": \"accepted\"}`` for async triggers.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "neemontology Ingestion Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ingest": {
      "post": {
        "description": "Trigger a non-blocking ingest for a single connection.\n\nWhen semantic compilation is on, a compilation pass follows the ingest so\nthe new or changed database gets its semantic layer straight away.",
        "operationId": "ingest_connection_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Connection",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ingest Connection"
      }
    },
    "/ingest/delete": {
      "post": {
        "description": "Trigger a non-blocking reset of a database's ingested data.\n\n``database_name`` is required: this endpoint always targets one database.",
        "operationId": "ingest_delete_ingest_delete_post",
        "parameters": [
          {
            "in": "query",
            "name": "database_name",
            "required": true,
            "schema": {
              "title": "Database Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ingest Delete"
      }
    },
    "/neem/status": {
      "get": {
        "description": "Report the NEEM folder watcher's view of each file in the folder.\n\nEach file is ``waiting`` (still changing), ``loading``, ``loaded`` or\n``failed`` (with the reason). ``catalog`` is ``ingesting`` while the merged\ndatabase is being re-read after a change. ``enabled`` is false when no\n``NEEM_DATA_DIR`` is configured.",
        "operationId": "neem_status_neem_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeemWatchStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Neem Status"
      }
    },
    "/reembed": {
      "post": {
        "description": "Rebuild every stored vector with the current embedding model.\n\nRuns in the background. Called when the embedding model changes; a request\nmade while a pass is running queues one more pass after it.",
        "operationId": "reembed_reembed_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Reembed"
      }
    },
    "/reembed/status": {
      "get": {
        "description": "Whether a re-embed pass is running, and how the last one ended.",
        "operationId": "reembed_state_reembed_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReembedStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Reembed State"
      }
    },
    "/semantic/compile": {
      "post": {
        "description": "Trigger a non-blocking semantic compilation pass.\n\nEnsures the scheduler is running first (``start()`` is idempotent), so this\nalso takes effect when compilation is enabled while the service is already\nup \u2014 no restart needed. Runs on the scheduler's own task.",
        "operationId": "semantic_compile_semantic_compile_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Semantic Compile"
      }
    },
    "/semantic/reset": {
      "post": {
        "description": "Trigger a non-blocking reset of a database's semantic layer.\n\nDeletes the semantic nodes and embeddings, then asks for a compilation pass\nso the layer is rebuilt straight away.\nOmitting ``database_name`` resets every database.\n\nThe three steps are strictly ordered \u2014 stop the running pass, wait for it to\nstop, delete, then rebuild \u2014 and run as a background task, so this returns\nimmediately while the wait can take minutes. They used to overlap, which\nlost data in both directions: a pass reads its work list once at the start,\nso one beginning before the delete finished saw every table still carrying a\nTerm and compiled nothing, while a pass still running during the delete kept\nwriting Terms it had already swept past.",
        "operationId": "semantic_reset_semantic_reset_post",
        "parameters": [
          {
            "in": "query",
            "name": "database_name",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Database Name"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Semantic Reset"
      }
    },
    "/semantic/status": {
      "get": {
        "description": "Report whether a compilation pass is executing right now, when the last\none finished successfully, and when it last failed (if that's more recent\nthan the last success).\n\nBacked by the ``semantic_compilation_history`` table (see ``history.py``),\nwhich this service owns \u2014 the neemontology API server relays this response rather\nthan reading that table itself.",
        "operationId": "semantic_status_semantic_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SemanticRunningResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Semantic Status"
      }
    },
    "/semantic/stop": {
      "post": {
        "description": "Ask the in-flight semantic compilation pass to stop.\n\nThe database being compiled finishes first \u2014 that work runs in a thread that\ncannot be interrupted \u2014 so the pass ends at the next database boundary. The\njob stays alive and runs again on the next trigger.",
        "operationId": "semantic_stop_semantic_stop_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Semantic Stop"
      }
    }
  }
}
